import XCTest
@testable import Impulse

final class StoreBackupManagerTests: XCTestCase {
    private var tempRoot: URL!
    private var storeURL: URL!
    private var backupRoot: URL!

    override func setUpWithError() throws {
        tempRoot = FileManager.default.temporaryDirectory
            .appendingPathComponent("StoreBackupManagerTests-\(UUID().uuidString)", isDirectory: true)
        try FileManager.default.createDirectory(at: tempRoot, withIntermediateDirectories: true)
        storeURL = tempRoot.appendingPathComponent("default.store", isDirectory: false)
        backupRoot = tempRoot.appendingPathComponent("store-backups", isDirectory: true)
    }

    override func tearDownWithError() throws {
        try? FileManager.default.removeItem(at: tempRoot)
    }

    // MARK: - Helpers

    private func writeFakeStore(suffixes: [String] = ["", "-shm", "-wal"], content: String = "store-bytes") throws {
        for suffix in suffixes {
            let url = URL(fileURLWithPath: storeURL.path + suffix)
            try Data(content.utf8).write(to: url)
        }
    }

    private func makeManager(keepCount: Int = 7) -> StoreBackupManager {
        StoreBackupManager(storeURL: storeURL, backupRoot: backupRoot, keepCount: keepCount)
    }

    private func todayFolder(in: Date = Date()) -> URL {
        let formatter = DateFormatter()
        formatter.locale = Locale(identifier: "en_US_POSIX")
        formatter.dateFormat = "yyyy-MM-dd"
        formatter.timeZone = TimeZone.current
        return backupRoot.appendingPathComponent(formatter.string(from: `in`), isDirectory: true)
    }

    // MARK: - Tests

    func test_noStore_isNoOp() throws {
        // No file at storeURL → must not create the backup directory.
        makeManager().runDailyBackupIfNeeded()
        XCTAssertFalse(FileManager.default.fileExists(atPath: backupRoot.path))
    }

    func test_firstRun_copiesAllThreeFiles() throws {
        try writeFakeStore()
        makeManager().runDailyBackupIfNeeded()

        let dest = todayFolder()
        XCTAssertTrue(FileManager.default.fileExists(atPath: dest.appendingPathComponent("default.store").path))
        XCTAssertTrue(FileManager.default.fileExists(atPath: dest.appendingPathComponent("default.store-shm").path))
        XCTAssertTrue(FileManager.default.fileExists(atPath: dest.appendingPathComponent("default.store-wal").path))
    }

    func test_walMissing_doesNotFail() throws {
        // SwiftData may not have created -shm/-wal yet (no transactions written).
        try writeFakeStore(suffixes: [""])
        makeManager().runDailyBackupIfNeeded()

        let dest = todayFolder()
        XCTAssertTrue(FileManager.default.fileExists(atPath: dest.appendingPathComponent("default.store").path))
        XCTAssertFalse(FileManager.default.fileExists(atPath: dest.appendingPathComponent("default.store-shm").path))
    }

    func test_secondRunSameDay_skipsCopy() throws {
        try writeFakeStore()
        let manager = makeManager()
        manager.runDailyBackupIfNeeded()

        // Mutate the store on disk; if the second run copied again the
        // backup file would be overwritten with the new content.
        try Data("changed".utf8).write(to: storeURL)
        manager.runDailyBackupIfNeeded()

        let backedUp = try Data(contentsOf: todayFolder().appendingPathComponent("default.store"))
        XCTAssertEqual(String(data: backedUp, encoding: .utf8), "store-bytes",
                       "Same-day re-run should be a no-op (was reading marker file?).")
    }

    func test_pruning_keepsOnlyKeepCount() throws {
        // Manually create 10 day folders; runDailyBackupIfNeeded should leave
        // at most keepCount + 1 (today + N prior).
        try writeFakeStore()
        try FileManager.default.createDirectory(at: backupRoot, withIntermediateDirectories: true)

        let formatter = DateFormatter()
        formatter.locale = Locale(identifier: "en_US_POSIX")
        formatter.dateFormat = "yyyy-MM-dd"
        formatter.timeZone = TimeZone.current

        let calendar = Calendar.current
        for daysAgo in 1...10 {
            let date = calendar.date(byAdding: .day, value: -daysAgo, to: Date())!
            let folder = backupRoot.appendingPathComponent(formatter.string(from: date), isDirectory: true)
            try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
            try Data("dummy".utf8).write(to: folder.appendingPathComponent("default.store"))
        }

        makeManager(keepCount: 3).runDailyBackupIfNeeded()

        let entries = try FileManager.default.contentsOfDirectory(
            at: backupRoot,
            includingPropertiesForKeys: [.isDirectoryKey],
            options: [.skipsHiddenFiles]
        )
        let dayFolders = entries.filter {
            (try? $0.resourceValues(forKeys: [.isDirectoryKey]).isDirectory) == true
        }
        // Today's folder + up to keepCount-1 older folders pruned to 3 total.
        XCTAssertEqual(dayFolders.count, 3)
    }

    func test_partialPriorBackupForToday_isReplaced() throws {
        // Prior run crashed mid-copy and left a partial folder for today.
        try writeFakeStore()
        let dest = todayFolder()
        try FileManager.default.createDirectory(at: dest, withIntermediateDirectories: true)
        try Data("garbage".utf8).write(to: dest.appendingPathComponent("default.store"))
        // Note: no marker file written → today is NOT considered done.

        makeManager().runDailyBackupIfNeeded()

        let backedUp = try Data(contentsOf: dest.appendingPathComponent("default.store"))
        XCTAssertEqual(String(data: backedUp, encoding: .utf8), "store-bytes")
    }

    // MARK: - listBackups

    /// Helper: synthesise a backup folder with given content under `dateID`.
    /// Stamps the folder with `schemaVersion` (default `SchemaVersion.current`)
    /// so existing happy-path tests don't trip the mismatch guard. Pass `nil`
    /// to simulate a legacy stamp-less backup.
    private func makeBackupFolder(
        _ dateID: String,
        content: String = "backup-bytes",
        schemaVersion: Int? = SchemaVersion.current
    ) throws -> URL {
        try FileManager.default.createDirectory(at: backupRoot, withIntermediateDirectories: true)
        let folder = backupRoot.appendingPathComponent(dateID, isDirectory: true)
        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
        try Data(content.utf8).write(to: folder.appendingPathComponent("default.store"))
        if let v = schemaVersion {
            let stamp = #"{"version":\#(v)}"#
            try Data(stamp.utf8).write(to: folder.appendingPathComponent("schema.json"))
        }
        return folder
    }

    func test_listBackups_emptyWhenNoFolder() {
        XCTAssertTrue(makeManager().listBackups().isEmpty)
    }

    func test_listBackups_returnsNewestFirst() throws {
        _ = try makeBackupFolder("2026-04-01")
        _ = try makeBackupFolder("2026-04-15")
        _ = try makeBackupFolder("2026-03-20")

        let backups = makeManager().listBackups()
        XCTAssertEqual(backups.map(\.id), ["2026-04-15", "2026-04-01", "2026-03-20"])
    }

    /// Non-ISO folders (e.g. our own "pre-restore-..." safety folders) must
    /// be excluded so they don't show up in the user-facing list.
    func test_listBackups_ignoresNonISOFolders() throws {
        _ = try makeBackupFolder("2026-04-01")
        try FileManager.default.createDirectory(
            at: backupRoot.appendingPathComponent("pre-restore-12345"),
            withIntermediateDirectories: true
        )
        try FileManager.default.createDirectory(
            at: backupRoot.appendingPathComponent("scratch"),
            withIntermediateDirectories: true
        )

        let backups = makeManager().listBackups()
        XCTAssertEqual(backups.map(\.id), ["2026-04-01"])
    }

    func test_listBackups_reportsSizeBytes() throws {
        let folder = try makeBackupFolder("2026-04-01", content: "abcdef") // 6 bytes
        try Data("xyz".utf8).write(to: folder.appendingPathComponent("default.store-wal")) // +3

        let entry = makeManager().listBackups().first
        XCTAssertEqual(entry?.sizeBytes, 9)
    }

    // MARK: - restore happy path

    func test_restore_replacesLiveStoreWithBackupContents() throws {
        try writeFakeStore(content: "current-bytes")
        let backupFolder = try makeBackupFolder("2026-04-01", content: "backup-bytes")
        try Data("backup-shm".utf8).write(to: backupFolder.appendingPathComponent("default.store-shm"))
        try Data("backup-wal".utf8).write(to: backupFolder.appendingPathComponent("default.store-wal"))

        let entry = StoreBackupManager.BackupEntry(
            id: "2026-04-01",
            url: backupFolder,
            sizeBytes: 0
        )
        try makeManager().restore(from: entry)

        XCTAssertEqual(try String(contentsOf: storeURL), "backup-bytes")
        XCTAssertEqual(try String(contentsOf: URL(fileURLWithPath: storeURL.path + "-shm")), "backup-shm")
        XCTAssertEqual(try String(contentsOf: URL(fileURLWithPath: storeURL.path + "-wal")), "backup-wal")
    }

    /// Even when the backup is missing -shm/-wal (older WAL not flushed), the
    /// .store file must still be restored. Stray live -shm/-wal from before
    /// must be cleared so they don't get attached to the new store.
    func test_restore_clearsLiveWAL_whenBackupHasNoneOfThem() throws {
        try writeFakeStore(content: "current") // creates .store, -shm, -wal
        let backupFolder = try makeBackupFolder("2026-04-01", content: "backup")

        let entry = StoreBackupManager.BackupEntry(
            id: "2026-04-01",
            url: backupFolder,
            sizeBytes: 0
        )
        try makeManager().restore(from: entry)

        XCTAssertEqual(try String(contentsOf: storeURL), "backup")
        XCTAssertFalse(FileManager.default.fileExists(
            atPath: URL(fileURLWithPath: storeURL.path + "-shm").path
        ))
        XCTAssertFalse(FileManager.default.fileExists(
            atPath: URL(fileURLWithPath: storeURL.path + "-wal").path
        ))
    }

    // MARK: - restore safety net

    /// Before mutating the live store, restore must snapshot it into a
    /// `pre-restore-*` folder so a botched restore is itself reversible.
    func test_restore_snapshotsLiveStoreFirst() throws {
        try writeFakeStore(content: "current-bytes")
        let backupFolder = try makeBackupFolder("2026-04-01", content: "backup-bytes")

        try makeManager().restore(from: .init(id: "2026-04-01", url: backupFolder, sizeBytes: 0))

        let entries = try FileManager.default.contentsOfDirectory(
            at: backupRoot,
            includingPropertiesForKeys: nil
        )
        let snapshotFolder = entries.first {
            $0.lastPathComponent.hasPrefix("pre-restore-")
        }
        XCTAssertNotNil(snapshotFolder, "pre-restore safety folder must exist after a restore")
        let snapshotStore = snapshotFolder!.appendingPathComponent("default.store")
        XCTAssertEqual(try String(contentsOf: snapshotStore), "current-bytes")
    }

    // MARK: - restore validation

    func test_restore_throws_whenBackupMissingMainStoreFile() throws {
        try writeFakeStore()
        // Create folder but no default.store inside.
        try FileManager.default.createDirectory(at: backupRoot, withIntermediateDirectories: true)
        let folder = backupRoot.appendingPathComponent("2026-04-01", isDirectory: true)
        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)

        let entry = StoreBackupManager.BackupEntry(id: "2026-04-01", url: folder, sizeBytes: 0)

        XCTAssertThrowsError(try makeManager().restore(from: entry)) { error in
            guard case StoreBackupManager.RestoreError.backupHasNoStoreFile = error else {
                XCTFail("Expected backupHasNoStoreFile, got \(error)")
                return
            }
        }
        // Live store must remain intact.
        XCTAssertEqual(try String(contentsOf: storeURL), "store-bytes")
    }

    /// When restore fails after deleting the live store but before fully
    /// copying the backup (simulated by destroying the source mid-flight),
    /// the safety snapshot must be rolled back so the user's data is not lost.
    ///
    /// We can't easily inject a mid-flight failure into `FileManager`, but
    /// we can prove the rollback *path* by removing the backup file after
    /// validation but before the copy step — except that's racy too. The
    /// realistic invariant we *can* test: after a successful restore, the
    /// live store is recoverable from the safety snapshot if needed.
    func test_safetySnapshot_isRecoverableAfterSuccessfulRestore() throws {
        try writeFakeStore(content: "original-bytes")
        let backupFolder = try makeBackupFolder("2026-04-01", content: "restored-bytes")

        try makeManager().restore(from: .init(id: "2026-04-01", url: backupFolder, sizeBytes: 0))

        // Find the pre-restore snapshot manually.
        let entries = try FileManager.default.contentsOfDirectory(
            at: backupRoot,
            includingPropertiesForKeys: nil
        )
        let snap = entries.first { $0.lastPathComponent.hasPrefix("pre-restore-") }!
        let snapStore = snap.appendingPathComponent("default.store")
        XCTAssertEqual(try String(contentsOf: snapStore), "original-bytes",
                       "Safety snapshot preserves the pre-restore state — manually recoverable")
    }
}
